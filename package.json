{
  "name": "herculito-push-api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/app/server.ts",
    "start": "bun src/app/server.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:json": "bun scripts/migrate-from-json.ts",
    "export:firestore": "bun scripts/export-firestore.ts",
    "export:firebase-users": "bun scripts/export-firebase-auth-users.ts",
    "import:clerk-users": "bun scripts/import-clerk-users.ts",
    "audit:auth-migration": "bun scripts/audit-auth-migration.ts",
    "cleanup:system": "bun scripts/cleanup-system-data.ts",
    "backfill:sessions": "bun scripts/backfill-sessions.ts"
  },
  "dependencies": {
    "jose": "^5.9.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.0",
    "firebase-admin": "^12.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
